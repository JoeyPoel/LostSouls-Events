# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Resend Email Transmission API
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Sender Address
# In development / testing without a custom domain, use Resend's free verified sandbox:
# RESEND_FROM_EMAIL="Lost Souls <onboarding@resend.dev>"
# Once your domain is verified on Resend:
# RESEND_FROM_EMAIL="Lost Souls <tickets@lostsouls.events>"
RESEND_FROM_EMAIL="Lost Souls <onboarding@resend.dev>"

# Administrator Notification Email
ADMIN_NOTIFICATION_EMAIL="joeywognum@gmail.com"
